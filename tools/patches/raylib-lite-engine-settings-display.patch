+static esp_gsp_esp_lcd_pause_t *s_brightness_pause;
+enum { MOSAICO_BRIGHTNESS_PAUSE_TIMEOUT_MS = 250 };
+
+static esp_err_t resume_brightness_display(void)
+{
+    if (!s_brightness_pause) return ESP_OK;
+    /* Failed resume must retain both the token and the original GSP handle.
+     * The token is consumed only on success; an idle app must retry it too. */
+    esp_gsp_handle_t resumed = NULL;
+    const esp_err_t err = esp_gsp_esp_lcd_resume_paused(s_brightness_pause, &resumed);
+    if (err == ESP_OK) {
+        s_brightness_pause = NULL;
+        s_gsp = resumed;
+    }
+    return err;
+}
+
+esp_err_t mosaico_game_app_set_brightness(int percent)
+{
+    if (percent < 0 || percent > 100) return ESP_ERR_INVALID_ARG;
+    if (!s_gsp || !s_app_task || xTaskGetCurrentTaskHandle() != s_app_task)
+        return ESP_ERR_INVALID_STATE;
+    esp_err_t err = resume_brightness_display();
+    if (err != ESP_OK) return err;
+    /* Pause waits for presenter fences, so the command cannot race GSP's
+     * panel transfers. A timeout leaves brightness unchanged. */
+    err = esp_gsp_esp_lcd_pause(s_gsp, MOSAICO_BRIGHTNESS_PAUSE_TIMEOUT_MS,
+                               &s_brightness_pause);
+    if (err != ESP_OK) return err;
+    const esp_err_t brightness_err = bsp_display_brightness_set(percent);
+    const esp_err_t resume_err = resume_brightness_display();
+    return brightness_err != ESP_OK ? brightness_err : resume_err;
+}
 
