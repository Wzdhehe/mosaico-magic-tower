+def _windows_port(original: Any) -> Any:
+    if (original.vid, original.pid) != (0x303A, 0x4002):
+        return original
+    port = copy.copy(original)
+    # pySerial derives this suffix from USB's MI_00 / MI_02 hardware ID.
+    # Windows usbser omits iInterface; COM numbering does not identify a role.
+    match = re.search(r":x\.([0-9]+)$", getattr(port, "location", None) or "")
+    expected = _IRIS_INTERFACES.get(int(match[1])) if match else None
+    declared = getattr(port, "interface", None) or ""
+    if declared:
+        name = declared if declared in _IRIS_INTERFACES.values() and (
+            match is None or declared == expected) else ""
+    else:
+        name = expected or ""
+    port.interface = name
+    port.iris_link_role = {"ESP-Iris 0.2 console": "control",
+                           "ESP-Iris 0.2 data": "data"}.get(name, "unknown")
+    return port
+
