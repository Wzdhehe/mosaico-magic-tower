+++ b/ESP-Iris/components/esp_iris/tools/tests/test_windows_usb.py
@@ -0,0 +1,58 @@
+"""Windows CDC roles use the USB MI number, never the COM port number."""
+import sys
+import unittest
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import patch
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+from iris_gateway import usb_descriptors
+
+
+def port(name="COM8", location="1-3:x.2", interface=None, pid=0x4002):
+    return SimpleNamespace(device=name, vid=0x303A, pid=pid,
+                           serial_number="1C2904D0BC08", location=location,
+                           interface=interface)
+
+
+class WindowsUsbTests(unittest.TestCase):
+    def enumerate(self, ports, platform="win32"):
+        with patch.object(usb_descriptors.sys, "platform", platform), \
+                patch.object(usb_descriptors.list_ports, "comports", return_value=ports):
+            return usb_descriptors.serial_ports()
+
+    def test_two_cdc_functions_ignore_com_number_and_order(self):
+        original = [port(), port("COM9", "1-3:x.0")]
+        result = self.enumerate(original)
+        self.assertEqual([usb_descriptors.link_role(p) for p in result], ["data", "control"])
+        self.assertEqual([p.interface for p in result],
+                         ["ESP-Iris 0.2 data", "ESP-Iris 0.2 console"])
+        self.assertTrue(all(p.interface is None for p in original))
+
+    def test_unknown_interface_numbers_do_not_become_control(self):
+        for location in (None, "1-3", "1-3:x.1", "1-3:x.3", "1-3:x.20"):
+            with self.subTest(location=location):
+                result = self.enumerate([port(location=location)])
+                self.assertEqual(usb_descriptors.link_role(result[0]), "unknown")
+
+    def test_descriptor_and_mi_conflict_is_unknown(self):
+        result = self.enumerate([port(interface="ESP-Iris 0.2 console")])
+        self.assertEqual(usb_descriptors.link_role(result[0]), "unknown")
+
+    def test_known_descriptor_without_location_is_retained(self):
+        result = self.enumerate([port(location=None, interface="ESP-Iris 0.2 data")])
+        self.assertEqual(usb_descriptors.link_role(result[0]), "data")
+
+    def test_other_firmware_interface_is_not_reinterpreted(self):
+        result = self.enumerate([port(interface="Other firmware")])
+        self.assertEqual(usb_descriptors.link_role(result[0]), "unknown")
+
+    def test_non_iris_and_non_windows_are_unchanged(self):
+        original = port(pid=0x0020)
+        self.assertIs(self.enumerate([original])[0], original)
+        original = port()
+        self.assertIs(self.enumerate([original], "linux")[0], original)
+
+
+if __name__ == "__main__":
+    unittest.main()
